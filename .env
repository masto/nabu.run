# Build-time settings. These end up in the public bundle, so nothing secret.
# Put local overrides in .env.local (not committed).

# Channel list; each entry can set its own baseUrl.
PREACT_APP_CHANNELS_URL='https://catalog.nabu.run/channels.json'

# Base URL for channels that don't set one, and the channel to use if the
# channel list can't be loaded.
PREACT_APP_BASE_URL='https://catalog.nabu.run/'
PREACT_APP_IMAGE_DIR='assets/cycles/cycle-2'

# CORS proxy for RetroNET file requests.
PREACT_APP_RETRONET_PROXY='https://catalog.nabu.run/proxy.php?mode=native&url='
